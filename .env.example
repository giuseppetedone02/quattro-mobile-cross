# ---- Pubbliche: finiscono nel bundle, protette da RLS / restrizioni per app ----
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com

# ---- Build-time: iniettate dai secret EAS, ristrette per package+SHA1 / bundle-id ----
GOOGLE_MAPS_ANDROID_KEY=AIza...
GOOGLE_MAPS_IOS_KEY=AIza...
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxx
EAS_PROJECT_ID=

# ---- MAI nel client. Solo secret delle Edge Function Supabase: ----
#   supabase secrets set GOOGLE_PLACES_KEY=...
#   supabase secrets set RESEND_API_KEY=...
